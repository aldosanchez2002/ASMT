{
  "version": 1,
  "dutyCycle": "OTR / normal: Detroit 'Long Haul' (6.0-6.9 mpg, 60k+ mi/yr), Cummins 'Normal', Freightliner 'Schedule II', PACCAR 'On Highway'",
  "notes": "Intervals are 'whichever comes first'. Miles are statute miles. Sources are linked per schedule. Verify against the manual before relying on an interval.",
  "settings": [
    {
      "id": "detroitApprovedOil",
      "label": "Detroit-approved engine oil",
      "description": "Oil on Detroit's DFS 93K222 / 93K223 approval list (look for it on the jug or data sheet). Off = oil change intervals are cut in half: Detroit says non-approved oil gets 'reduced' intervals without giving a number, so this is a conservative assumption; confirm with your dealer.",
      "default": true,
      "appliesTo": "Detroit engines"
    },
    {
      "id": "frameMountedFuelFilter",
      "label": "Frame-mounted fuel filter",
      "description": "Detroit fuel filter / water separator or Davco 385/482/485/487 on the frame rail. Off = the engine fuel filter is changed at every oil change.",
      "default": true,
      "appliesTo": "Detroit engines"
    },
    {
      "id": "extendedLifeCoolant",
      "label": "Extended-life coolant",
      "description": "Off = standard-life coolant: tested at every oil change interval and replaced every 300,000 mi.",
      "default": true,
      "appliesTo": "Detroit engines"
    },
    {
      "id": "premiumBlue",
      "label": "Valvoline Premium Blue oil",
      "description": "Cummins adds 5,000 mi to X15 oil change intervals with Valvoline Premium Blue.",
      "default": false,
      "appliesTo": "Cummins X15 (2020 and newer)"
    }
  ],
