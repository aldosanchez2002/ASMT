  "schedules": [
    {
      "id": "detroit-dd13-epa10-longhaul",
      "name": "Detroit DD13 (EPA10) - Long Haul",
      "category": "engine",
      "source": "detroit-ghg17-tables",
      "items": [
        {
          "id": "oil",
          "name": "Engine oil & oil filter",
          "intervalMiles": 55000,
          "notes": "Requires DFS 93K222/93K223-approved oil; non-approved oil = reduced interval",
          "variants": [
            {
              "when": {
                "detroitApprovedOil": false
              },
              "intervalMiles": 27500,
              "notes": "Not Detroit-approved oil: interval cut in half (conservative assumption; confirm with your dealer)"
            }
          ]
        },
        {
          "id": "fuel-filter-engine",
          "name": "Engine fuel filter (with frame-mounted filter)",
          "intervalMiles": 100000,
          "notes": "Without a frame-mounted filter: every 55,000 mi",
          "variants": [
            {
              "when": {
                "frameMountedFuelFilter": false
              },
              "name": "Engine fuel filter",
              "intervalMiles": 55000,
              "notes": "No frame-mounted filter: change at every oil change. Never exceed 100k mi on engine fuel filters"
            }
          ]
        },
        {
          "id": "fuel-filter-frame",
          "name": "Frame-mounted fuel filter / water separator",
          "intervalMiles": 55000,
          "onlyWhen": {
            "frameMountedFuelFilter": true
          }
        },
        {
          "id": "valve-lash",
          "name": "Valve lash adjustment",
          "firstDueMiles": 100000,
          "intervalMiles": 500000,
          "notes": "EPA07/EPA10/GHG14: at 100,000 mi, at 500,000 mi, then every 500,000 mi"
        },
        {
          "id": "coolant-maintain",
          "name": "Extended-life coolant - test/maintain",
          "intervalMiles": 110000,
          "intervalMonths": 12,
          "variants": [
            {
              "when": {
                "extendedLifeCoolant": false
              },
              "name": "Standard coolant - test/maintain (SCA)",
              "intervalMiles": 55000,
              "intervalMonths": 12,
              "notes": "Standard-life coolant: test and add SCA at every oil change interval or 1 year"
            }
          ]
        },
        {
          "id": "coolant-replace",
          "name": "Extended-life coolant - replace",
          "intervalMiles": 600000,
          "variants": [
            {
              "when": {
                "extendedLifeCoolant": false
              },
              "name": "Standard coolant - replace",
              "intervalMiles": 300000
            }
          ]
        },
        {
          "id": "belts",
          "name": "Drive belts - replace (inspect at every oil change)",
          "intervalMiles": 200000
        },
        {
          "id": "dpf",
          "name": "DPF ash cleaning",
          "intervalMiles": 300000,
          "intervalHours": 9000,
          "rangeMiles": [
            300000,
            400000
          ],
          "notes": "Normal range 300k-400k mi / 9,000-10,250 h, or when the check-engine lamp indicates"
        },
        {
          "id": "def-filter",
          "name": "DEF pump filter",
          "intervalMiles": 175000,
          "intervalMonths": 36
        }
      ]
    },
