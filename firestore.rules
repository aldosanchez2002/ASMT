rules_version = '2';

// PROTOTYPE MODE: anyone can read the fleet list; nobody can write from a
// browser. The sync job writes with the Admin SDK, which bypasses these rules.
//
// To require sign-in later: set requireSignIn = true in web/firebase-config.js,
// set the ALLOWED_EMAILS secret, and change both `if true` reads to
// `if isAllowed()`.

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    match /vehicles/{id} {
      allow read: if true;
    }
    match /meta/{id} {
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
